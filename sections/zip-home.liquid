{% assign source = section.settings.featured_collection | default: collections.all %}
<section id="black-videira" class="zip-hero zip-container" data-banner-slider data-autoplay="{{ section.settings.autoplay }}"><div class="zip-banner-stage"><div data-banner-slide><h1 class="nv-sr-only">Black Friday Videira · 27 a 30 de novembro</h1><a href="{{ section.settings.banner_link | default: routes.all_products_collection_url }}">{% if section.settings.banner_image %}{{ section.settings.banner_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: 'Black Videira' }}{% else %}<img src="{{ 'zip-banner-main.webp' | asset_url }}" alt="Black Videira · 27 a 30 de novembro · condições em breve" width="2400" height="696" fetchpriority="high">{% endif %}</a></div>{% for block in section.blocks %}{% if block.type == 'banner' and block.settings.image %}<div data-banner-slide hidden><a href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', alt: block.settings.image.alt }}</a></div>{% endif %}{% endfor %}</div>{% if section.blocks.size > 0 %}<div class="zip-banner-controls"><button type="button" data-banner-previous aria-label="Banner anterior">‹</button><button type="button" data-banner-next aria-label="Próximo banner">›</button><button type="button" data-banner-pause aria-label="Pausar banners" aria-pressed="false">Ⅱ</button></div>{% endif %}</section>
{% render 'zip-shelf', products: source.products, title: section.settings.featured_title, anchor: 'selecao' %}
<section class="zip-categories zip-container">{% render 'zip-title', title: 'Compre por Categoria' %}<div class="zip-category-row">{% assign categories = 'all,tinto,espumante,branco,rose,new,kits' | split: ',' %}{% assign files = 'categoria-mais-vendidos.webp,categoria-tintos.webp,categoria-espumantes.webp,categoria-brancos.webp,categoria-roses.webp,categoria-premiados.webp,categoria-kits.webp' | split: ',' %}{% assign labels = 'Destaques,Tintos,Espumantes,Brancos,Rosés,Seleções,Caixas' | split: ',' %}{% for category in categories %}{% capture destination %}{% render 'category-link', category: category %}{% endcapture %}{% assign file = 'zip-' | append: files[forloop.index0] %}<a href="{{ destination | strip }}"{% if category == 'new' %} class="zip-new-category"{% endif %}>{% if category == 'new' %}{% assign first_image = source.products.first.featured_image %}{% if first_image %}{{ first_image | image_url: width: 360 | image_tag: loading: 'lazy', alt: 'Novidades' }}{% endif %}<span>NOVIDADES</span>{% else %}<img src="{{ file | asset_url }}" alt="{{ labels[forloop.index0] }}" width="900" height="1254" loading="lazy">{% endif %}</a>{% endfor %}</div></section>
{% assign kits = section.settings.kit_collection %}{% if kits.products_count > 0 %}{% render 'zip-shelf', products: kits.products, title: 'Garanta seu kit de vinhos', anchor: 'caixas' %}{% else %}{% render 'zip-shelf', products: source.products, title: 'Monte sua caixa de vinhos', anchor: 'caixas', boxes: true %}{% endif %}
<section class="zip-price-section zip-container">{% render 'zip-title', title: 'Seu preço ideal' %}<div class="zip-price-row">{% assign price_files = 'ate-50.webp,ate-100.webp,ate-200.webp,acima-200.webp' | split: ',' %}{% assign queries = 'filter.v.price.lte=50,filter.v.price.gte=50&filter.v.price.lte=100,filter.v.price.gte=100&filter.v.price.lte=200,filter.v.price.gte=200' | split: ',' %}{% assign labels = 'Até R$ 50,R$ 50 a R$ 100,R$ 100 a R$ 200,Acima de R$ 200' | split: ',' %}{% for file in price_files %}{% assign asset = 'zip-' | append: file %}<a href="{{ routes.all_products_collection_url }}?{{ queries[forloop.index0] | escape }}"><img src="{{ asset | asset_url }}" alt="{{ labels[forloop.index0] }}" width="2675" height="2000" loading="lazy"></a>{% endfor %}</div></section>
{% assign offer_collection = section.settings.offers_collection %}{% if offer_collection.products_count > 0 %}{% render 'zip-shelf', products: offer_collection.products, title: 'Aproveite, o preço baixou' %}{% else %}{% render 'zip-shelf', products: source.products, title: 'Vinhos para o seu dia a dia' %}{% endif %}
<section class="zip-harmonizations zip-container">{% render 'zip-title', title: 'Harmonizações' %}<div class="zip-food-row">{% assign foods = 'carnes-vermelhas.webp,pizzas.webp,queijos.webp,orientais.webp,massas.webp,frutos-do-mar.webp,carnes-brancas.webp,risotos.webp,peixes.webp,legumes.webp,saladas.webp,sobremesas.webp' | split: ',' %}{% assign food_labels = 'Carnes vermelhas,Pizzas,Queijos,Orientais,Massas,Frutos do mar,Carnes brancas,Risotos,Peixes,Legumes,Saladas,Sobremesas' | split: ',' %}{% assign kinds = 'tinto,tinto,rose,branco,tinto,branco,branco,branco,branco,rose,branco,espumante' | split: ',' %}{% for food in foods %}{% assign asset = 'zip-' | append: food %}{% capture destination %}{% render 'category-link', category: kinds[forloop.index0] %}{% endcapture %}<a href="{{ destination | strip }}"><img src="{{ asset | asset_url }}" alt="{{ food_labels[forloop.index0] }}" width="1428" height="1453" loading="lazy"></a>{% endfor %}</div></section>
<section class="zip-double-banner zip-container"><a href="{{ routes.all_products_collection_url }}?sort_by=created-descending"><img src="{{ 'videira-hero.jpg' | asset_url }}" alt="Brinde com vinhos da Videira" width="1600" height="1067" loading="lazy"><span>Novos rótulos.<strong>Novas descobertas.</strong><small>Conheça as novidades →</small></span></a><a href="{{ routes.root_url }}#caixas"><img src="{{ 'videira-hero.jpg' | asset_url }}" alt="Vinhos para compartilhar" width="1600" height="1067" loading="lazy"><span>A sua seleção.<strong>Do seu jeito.</strong><small>Escolha suas garrafas →</small></span></a></section>
{% assign newest = section.settings.new_collection | default: collections.all %}{% assign newest_products = newest.products | sort: 'created_at' | reverse %}{% render 'zip-shelf', products: newest_products, title: 'Novidades na Videira', anchor: 'novidades' %}
<section id="paises" class="zip-countries zip-container">{% render 'zip-title', title: 'Encontre por país' %}<div>{% assign countries = 'Argentina,Chile,Brasil' | split: ',' %}{% assign flags = 'argentina.webp,chile.webp,brasil.webp' | split: ',' %}{% assign country_queries = 'vendor:"Gascón" OR vendor:"Susana Balbo" OR vendor:"Mosquita Muerta" OR vendor:"Martino" OR vendor:"Puna",vendor:"Becas",vendor:"Casa Valduga" OR vendor:"Ponto Nero"' | split: ',' %}{% for country in countries %}{% assign asset = 'zip-' | append: flags[forloop.index0] %}<a href="{{ routes.search_url }}?type=product&amp;q={{ country_queries[forloop.index0] | url_encode }}"><img src="{{ asset | asset_url }}" alt="{{ country }}" loading="lazy" width="500" height="350"></a>{% endfor %}</div></section>
<section id="bodegas" class="zip-brands zip-container">{% render 'zip-title', title: 'Marcas' %}<div>{% for vendor in shop.vendors %}<a href="{{ vendor | url_for_vendor }}">{% if vendor == 'Casa Valduga' %}<img src="{{ 'zip-casa-valduga-v2.webp' | asset_url }}" alt="Casa Valduga" width="270" height="100" loading="lazy">{% elsif vendor == 'Mosquita Muerta' %}<img src="{{ 'zip-mosquita-muerta-v2.webp' | asset_url }}" alt="Mosquita Muerta" width="270" height="100" loading="lazy">{% else %}<span>{{ vendor | escape }}</span>{% endif %}</a>{% endfor %}</div></section>
{% schema %}{"name":"Videira · Loja ZIP","settings":[{"type":"image_picker","id":"banner_image","label":"Banner principal"},{"type":"url","id":"banner_link","label":"Destino do banner"},{"type":"checkbox","id":"autoplay","label":"Alternar banners automaticamente","default":true},{"type":"text","id":"featured_title","label":"Título da primeira vitrine","default":"Destaques da Videira"},{"type":"collection","id":"featured_collection","label":"Coleção principal"},{"type":"collection","id":"kit_collection","label":"Coleção de kits prontos"},{"type":"collection","id":"offers_collection","label":"Coleção de ofertas reais"},{"type":"collection","id":"new_collection","label":"Coleção de novidades"}],"blocks":[{"type":"banner","name":"Banner adicional","settings":[{"type":"image_picker","id":"image","label":"Arte"},{"type":"url","id":"link","label":"Destino"}]}],"presets":[{"name":"Videira · Loja ZIP"}]}{% endschema %}

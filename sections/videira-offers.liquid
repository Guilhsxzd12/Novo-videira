{% assign offer_count = 0 %}{% capture offer_cards %}{% for product in collections.all.products %}{% if product.compare_at_price > product.price %}{% if offer_count < 12 %}{% render 'product-card', product: product %}{% assign offer_count = offer_count | plus: 1 %}{% endif %}{% endif %}{% endfor %}{% endcapture %}
{% if offer_count > 0 %}<section class="wc-section"><div class="wc-heading"><div><h2>Ofertas da adega</h2></div><div class="wc-controls"><a href="{{ routes.all_products_collection_url }}">Ver catálogo {% render 'icon', name: 'arrow' %}</a><button type="button" hidden data-carousel-step="-1" aria-label="{{ 'general.previous' | t }}">‹</button><button type="button" hidden data-carousel-step="1" aria-label="{{ 'general.next' | t }}">›</button></div></div><div class="wc-viewport" tabindex="0" aria-label="Ofertas da adega"><div class="wc-track"><div class="wc-group">{{ offer_cards }}</div></div></div></section>{% endif %}
{% schema %}{"name":"Videira · Ofertas reais","settings":[],"presets":[{"name":"Videira · Ofertas reais"}]}{% endschema %}

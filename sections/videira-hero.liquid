{% assign campaign_url = section.settings.link | default: routes.all_products_collection_url %}
<section class="nv-campaign" aria-label="Campanha Videira">
{% if section.settings.desktop_image %}
  <h1 class="nv-sr-only">{{ section.settings.title | escape }} {{ section.settings.accent | escape }}</h1><a class="nv-campaign-art" href="{{ campaign_url }}"><picture>{% if section.settings.mobile_image %}<source media="(max-width: 760px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}{{ section.settings.desktop_image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', alt: section.settings.title }}</picture></a>
{% else %}
  <div class="nv-campaign-inner nv-container">
    <div class="nv-campaign-copy"><p class="nv-campaign-label">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.title | escape }}<span>{{ section.settings.accent | escape }}</span></h1><p class="nv-campaign-date">{{ section.settings.dates | escape }}</p><p class="nv-campaign-description">{{ section.settings.intro | escape }}</p><a class="nv-button" href="{{ campaign_url }}">Ver os vinhos {% render 'icon', name: 'arrow' %}</a></div>
    <div class="nv-campaign-products" aria-hidden="true">{% for product in collections.all.products limit: 3 %}{% if product.featured_image %}<div class="nv-campaign-bottle nv-campaign-bottle--{{ forloop.index }}">{{ product.featured_image | image_url: width: 800 | image_tag: alt: '', loading: 'eager', widths: '300,500,800', sizes: '(max-width: 760px) 28vw, 18vw' }}</div>{% endif %}{% endfor %}<span class="nv-campaign-seal">VINHOS<br><strong>VIDEIRA</strong><br>VINHOTECA</span></div>
  </div>
{% endif %}
</section>
{% schema %}
{"name":"Videira · Campanha","settings":[{"type":"text","id":"eyebrow","label":"Chamada","default":"NOVEMBRO NA VIDEIRA"},{"type":"text","id":"title","label":"Título","default":"BLACK"},{"type":"text","id":"accent","label":"Segunda linha","default":"FRIDAY"},{"type":"text","id":"dates","label":"Datas","default":"27 A 30 DE NOVEMBRO"},{"type":"textarea","id":"intro","label":"Descrição","default":"Prepare sua seleção. Descontos em vinhos e caixas, com condições divulgadas em breve."},{"type":"image_picker","id":"desktop_image","label":"Arte para computador"},{"type":"image_picker","id":"mobile_image","label":"Arte para celular"},{"type":"url","id":"link","label":"Destino do banner"}],"presets":[{"name":"Videira · Campanha"}]}
{% endschema %}

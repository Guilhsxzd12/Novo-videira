<section id="black-videira" class="nv-banner-slider nv-container" data-banner-slider data-autoplay="{{ section.settings.autoplay }}" aria-label="Campanhas da Videira" aria-roledescription="carrossel">
<div class="nv-banner-stage">
{% if section.settings.desktop_image %}<div data-banner-slide><h1 class="nv-sr-only">{{ section.settings.title | escape }} {{ section.settings.accent | escape }}</h1><a class="nv-campaign-art" href="{{ section.settings.link | default: routes.all_products_collection_url }}"><picture>{% if section.settings.mobile_image %}<source media="(max-width:760px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}{{ section.settings.desktop_image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.title }}</picture></a></div>{% else %}{% render 'campaign-slide', first: true, theme: 'black', eyebrow: section.settings.eyebrow, title: section.settings.title, accent: section.settings.accent, text: section.settings.intro, small: section.settings.dates, large: 'PREPARE-SE', note: 'Condições divulgadas em breve.', cta: 'Prepare sua seleção', link: section.settings.link %}{% endif %}
{% for block in section.blocks %}{% render 'campaign-slide', first: false, theme: block.settings.theme, eyebrow: 'VIDEIRA VINHOTECA', title: block.settings.title, accent: block.settings.accent, text: block.settings.text, small: block.settings.small, large: block.settings.large, note: block.settings.note, cta: block.settings.cta, link: block.settings.link %}{% endfor %}
</div>
{% if section.blocks.size > 0 %}<div class="nv-banner-controls"><button type="button" data-banner-previous aria-label="Banner anterior">‹</button><div role="group" aria-label="Escolher banner"><button type="button" data-banner-dot="0" aria-label="Banner 1" aria-pressed="true"></button>{% for block in section.blocks %}<button type="button" data-banner-dot="{{ forloop.index }}" aria-label="Banner {{ forloop.index | plus: 1 }}" aria-pressed="false"></button>{% endfor %}</div><button type="button" data-banner-next aria-label="Próximo banner">›</button><button type="button" class="nv-banner-pause" data-banner-pause aria-label="Pausar banners" aria-pressed="false">Ⅱ</button></div>{% endif %}
</section>
{% schema %}
{"name":"Videira · Campanha","max_blocks":4,"settings":[{"type":"text","id":"eyebrow","label":"Chamada","default":"BLACK FRIDAY · VIDEIRA VINHOTECA"},{"type":"text","id":"title","label":"Título","default":"BLACK"},{"type":"text","id":"accent","label":"Segunda linha","default":"VIDEIRA"},{"type":"text","id":"dates","label":"Datas","default":"27 A 30 DE NOVEMBRO"},{"type":"textarea","id":"intro","label":"Descrição","default":"Vinhos e caixas para preparar sua seleção."},{"type":"image_picker","id":"desktop_image","label":"Arte para computador"},{"type":"image_picker","id":"mobile_image","label":"Arte para celular"},{"type":"url","id":"link","label":"Destino do banner"},{"type":"checkbox","id":"autoplay","label":"Alternar banners automaticamente","default":true}],"blocks":[{"type":"campaign","name":"Banner adicional","settings":[{"type":"text","id":"title","label":"Título","default":"SEU PRÓXIMO"},{"type":"text","id":"accent","label":"Destaque","default":"VINHO"},{"type":"textarea","id":"text","label":"Texto","default":"Explore o catálogo da Videira."},{"type":"text","id":"small","label":"Chamada lateral","default":"VINHOS COM"},{"type":"text","id":"large","label":"Destaque lateral","default":"ORIGEM"},{"type":"text","id":"note","label":"Complemento","default":"Para a sua mesa."},{"type":"text","id":"cta","label":"Texto do botão","default":"Ver vinhos"},{"type":"url","id":"link","label":"Destino"},{"type":"select","id":"theme","label":"Cor","default":"wine","options":[{"value":"wine","label":"Bordô"},{"value":"cream","label":"Creme"}]}]}],"presets":[{"name":"Videira · Campanha"}]}
{% endschema %}

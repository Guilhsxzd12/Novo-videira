{% assign price_filter = false %}{% for filter in collections.all.filters %}{% if filter.type == 'price_range' %}{% assign price_filter = true %}{% assign min_param = filter.min_value.param_name %}{% assign max_param = filter.max_value.param_name %}{% endif %}{% endfor %}
{% if price_filter %}<section class="nv-prices nv-container"><div class="nv-section-heading"><h2>Seu preço ideal</h2><span>Escolha quanto quer investir</span></div><div class="nv-price-grid"><a href="{{ routes.all_products_collection_url }}?{{ max_param }}=49.99"><small>VINHOS ATÉ</small><strong>R$ 50</strong>{% render 'icon', name: 'arrow' %}</a><a href="{{ routes.all_products_collection_url }}?{{ min_param }}=50&amp;{{ max_param }}=99.99"><small>DE R$ 50 ATÉ</small><strong>R$ 100</strong>{% render 'icon', name: 'arrow' %}</a><a href="{{ routes.all_products_collection_url }}?{{ min_param }}=100&amp;{{ max_param }}=199.99"><small>DE R$ 100 ATÉ</small><strong>R$ 200</strong>{% render 'icon', name: 'arrow' %}</a><a href="{{ routes.all_products_collection_url }}?{{ min_param }}=200"><small>VINHOS A PARTIR DE</small><strong>R$ 200</strong>{% render 'icon', name: 'arrow' %}</a></div></section>{% endif %}
{% schema %}{"name":"Videira · Faixas de preço","settings":[],"presets":[{"name":"Videira · Faixas de preço"}]}{% endschema %}

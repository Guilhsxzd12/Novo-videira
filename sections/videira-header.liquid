{% liquid
  assign catalog_url = routes.all_products_collection_url
  assign countries_url = catalog_url
  assign grapes_url = catalog_url
  for wine in collections.all.products
    if wine.metafields.custom.country.value != blank
      assign countries_url = routes.root_url | append: '#paises'
    endif
    if wine.metafields.custom.grape.value != blank
      assign grapes_url = routes.root_url | append: '#uvas'
    endif
  endfor
%}
{% if section.settings.announcement != blank %}<div class="nv-announcement">{{ section.settings.announcement | escape }}</div>{% endif %}
<div class="nv-ticker" aria-label="Informações da loja"><span>VINHOS NACIONAIS E IMPORTADOS</span><span>GARRAFAS E CAIXAS</span><a href="{{ routes.root_url }}#faq">ATENDIMENTO VIDEIRA</a></div><header class="nv-header vn-header">
  <div class="nv-header-main">
    <a class="nv-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — início">{% render 'logo' %}</a>
    <form class="nv-search" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Busque por vinho, uva ou bodega" aria-label="Buscar por vinho, uva, país ou bodega">
      <button type="submit" aria-label="Pesquisar vinhos">{% render 'icon', name: 'search' %}</button>
    </form>
    <div class="nv-header-actions">
      {% if shop.customer_accounts_enabled %}<a class="nv-account" href="{{ routes.account_url }}" aria-label="Minha conta">{% render 'icon', name: 'account' %}<span>Minha conta</span></a>{% endif %}
      <a class="nv-bag" href="{{ routes.cart_url }}" data-cart-open aria-label="Abrir minha seleção de vinhos">{% render 'icon', name: 'bag' %}<span class="nv-bag-label">Minha seleção</span><span class="nv-cart-count" data-cart-count>{{ cart.item_count }}</span></a>
      <button class="nv-menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="vn-mobile" aria-label="Abrir menu">{% render 'icon', name: 'menu' %}</button>
    </div>
  </div>
  <nav class="nv-navigation" aria-label="Navegação principal"><a class="nv-menu-campaign" href="{{ routes.root_url }}#black-videira">BLACK VIDEIRA</a><a href="{{ catalog_url }}?sort_by=created-descending">Lançamentos</a><a href="{{ routes.root_url }}#caixas">Kits</a>
<details class="nv-nav-group vn-group"><summary>Preços ⌄</summary><div class="nv-dropdown"><a href="{{ catalog_url }}?filter.v.price.lte=50">Até R$ 50</a><a href="{{ catalog_url }}?filter.v.price.gte=50&amp;filter.v.price.lte=100">R$ 50 a R$ 100</a><a href="{{ catalog_url }}?filter.v.price.gte=100&amp;filter.v.price.lte=200">R$ 100 a R$ 200</a><a href="{{ catalog_url }}?filter.v.price.gte=200">Acima de R$ 200</a></div></details>
<details class="nv-nav-group vn-group"><summary>Países ⌄</summary><div class="nv-dropdown"><a href="{{ routes.root_url }}#paises">Todos os países</a><a href="{{ routes.search_url }}?type=product&amp;q=vendor%3A%22Gasc%C3%B3n%22%20OR%20vendor%3A%22Susana%20Balbo%22%20OR%20vendor%3A%22Mosquita%20Muerta%22%20OR%20vendor%3A%22Martino%22%20OR%20vendor%3A%22Puna%22">Argentina</a><a href="{{ routes.search_url }}?type=product&amp;q=vendor%3ABecas">Chile</a><a href="{{ routes.search_url }}?type=product&amp;q=vendor%3A%22Casa%20Valduga%22%20OR%20vendor%3A%22Ponto%20Nero%22">Brasil</a></div></details>
<details class="nv-nav-group vn-group"><summary>Tipos e uvas ⌄</summary><div class="nv-dropdown nv-mega"><div><strong>Tipos de vinho</strong>{% assign categories = 'tinto,branco,rose,espumante' | split: ',' %}{% assign category_titles = 'Tintos,Brancos,Rosés,Espumantes' | split: ',' %}{% for category in categories %}{% capture destination %}{% render 'category-link', category: category %}{% endcapture %}<a href="{{ destination | strip }}">{{ category_titles[forloop.index0] }}</a>{% endfor %}</div><div><strong>Uvas</strong>{% assign grapes = 'Malbec,Cabernet Sauvignon,Chardonnay,Sauvignon Blanc,Merlot,Pinot Noir' | split: ',' %}{% for grape in grapes %}<a href="{{ routes.search_url }}?type=product&amp;q={{ grape | url_encode }}">{{ grape }}</a>{% endfor %}</div></div></details>
<details class="nv-nav-group vn-group"><summary>Marcas ⌄</summary><div class="nv-dropdown">{% for vendor in shop.vendors limit: 12 %}<a href="{{ vendor | url_for_vendor }}">{{ vendor | escape }}</a>{% endfor %}</div></details>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}<a href="{{ routes.all_products_collection_url }}">Todos os vinhos</a><a class="nv-nav-help" href="{{ routes.root_url }}#faq">Atendimento</a></nav>
  <nav id="vn-mobile" class="nv-mobile" hidden aria-label="Menu para celular">
    <a href="{{ catalog_url }}">Todos os vinhos {% render 'icon', name: 'arrow' %}</a>
    {% assign categories = 'tinto,branco,rose,espumante' | split: ',' %}{% assign category_titles = 'Tintos,Brancos,Rosés,Espumantes' | split: ',' %}{% for category in categories %}{% capture destination %}{% render 'category-link', category: category %}{% endcapture %}<a href="{{ destination | strip }}">{{ category_titles[forloop.index0] }}</a>{% endfor %}
    <a href="{{ countries_url }}">Países</a><a href="{{ grapes_url }}">Uvas</a><a href="{{ routes.root_url }}#bodegas">Bodegas</a>
    {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% for child in link.links %}<a class="nv-mobile-child" href="{{ child.url }}">{{ child.title | escape }}</a>{% endfor %}{% endfor %}
    <a href="{{ routes.root_url }}#sobre">A Videira</a><a href="{{ routes.root_url }}#faq">Entregas e atendimento</a>
    {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Minha conta</a>{% endif %}
  </nav>
</header>
{% schema %}
{"name":"Videira · Cabeçalho","class":"nv-header-section","settings":[{"type":"text","id":"announcement","label":"Faixa superior","default":"Vinhos com identidade. Momentos que ficam. · Foz do Iguaçu, PR"},{"type":"link_list","id":"menu","label":"Links adicionais"}]}
{% endschema %}

<div class="zip-perks zip-announcements" data-announcements aria-label="Informações da Videira"><div class="zip-announcement-window">{% assign messages = 'VINHOS NACIONAIS E IMPORTADOS|GARRAFAS E CAIXAS|ATENDIMENTO VIDEIRA|BLACK VIDEIRA · 27 A 30 DE NOVEMBRO' | split: '|' %}{% for message in messages %}<span class="zip-announcement"{% unless forloop.first %} hidden{% endunless %}>{{ message }}</span>{% endfor %}</div><button type="button" data-announcement-pause aria-label="Pausar mensagens" aria-pressed="false">Ⅱ</button></div>
<header class="zip-header vn-header"><div class="zip-header-middle zip-container"><a class="zip-logo" href="{{ routes.root_url }}" aria-label="Videira Vinhoteca — início">{% render 'logo' %}</a><form class="zip-search" action="{{ routes.search_url }}" method="get" role="search"><input type="hidden" name="type" value="product"><input type="search" name="q" placeholder="Faça uma pesquisa..." value="{{ search.terms | escape }}" aria-label="Pesquisar vinhos"><button type="submit" aria-label="Pesquisar">{% render 'icon', name: 'search' %}</button></form><div class="zip-header-actions">{% if shop.customer_accounts_enabled %}<a class="zip-account" href="{{ routes.account_url }}">{% render 'icon', name: 'account' %}<span>Entre ou Cadastre-se</span></a>{% endif %}<button type="button" data-wishlist-open aria-label="Meus favoritos">{% render 'icon', name: 'heart' %}</button><a class="zip-header-cart" href="{{ routes.cart_url }}" data-cart-open aria-label="Abrir carrinho">{% render 'icon', name: 'bag' %}<span data-cart-count>{{ cart.item_count }}</span></a><button type="button" class="zip-menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="vn-mobile" aria-label="Abrir menu">{% render 'icon', name: 'menu' %}</button></div></div>
<nav class="zip-navigation" aria-label="Navegação principal"><div class="zip-container"><a class="zip-black-link" href="{{ routes.root_url }}#black-videira">BLACK VIDEIRA</a><a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">Lançamentos</a><a href="{{ routes.root_url }}#caixas">Caixas</a><details class="nv-nav-group vn-group"><summary>Preços</summary><div class="zip-dropdown"><a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=50">Até R$ 50</a><a href="{{ routes.all_products_collection_url }}?filter.v.price.gte=50&amp;filter.v.price.lte=100">R$ 50 a R$ 100</a><a href="{{ routes.all_products_collection_url }}?filter.v.price.gte=100&amp;filter.v.price.lte=200">R$ 100 a R$ 200</a><a href="{{ routes.all_products_collection_url }}?filter.v.price.gte=200">Acima de R$ 200</a></div></details><a href="{{ routes.root_url }}#paises">Países</a><details class="nv-nav-group vn-group"><summary>Categorias</summary><div class="zip-dropdown">{% assign categories = 'tinto,branco,rose,espumante' | split: ',' %}{% assign labels = 'Tintos,Brancos,Rosés,Espumantes' | split: ',' %}{% for category in categories %}{% capture destination %}{% render 'category-link', category: category %}{% endcapture %}<a href="{{ destination | strip }}">{{ labels[forloop.index0] }}</a>{% endfor %}</div></details><details class="nv-nav-group vn-group"><summary>Uvas</summary><div class="zip-dropdown">{% assign grapes = 'Malbec,Cabernet Sauvignon,Chardonnay,Sauvignon Blanc,Merlot,Pinot Noir' | split: ',' %}{% for grape in grapes %}<a href="{{ routes.search_url }}?type=product&amp;q={{ grape | url_encode }}">{{ grape }}</a>{% endfor %}</div></details><a href="{{ routes.root_url }}#selecao">Destaques</a><a href="{{ routes.root_url }}#caixas">Vinhos em caixas</a><a class="zip-gold-link" href="{{ routes.root_url }}#novidades">Novidades</a>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</div></nav>
<nav id="vn-mobile" class="zip-mobile" hidden aria-label="Menu para celular"><a href="{{ routes.all_products_collection_url }}">Todos os vinhos</a><a href="{{ routes.root_url }}#black-videira">Black Videira</a>{% assign categories = 'tinto,branco,rose,espumante' | split: ',' %}{% assign labels = 'Tintos,Brancos,Rosés,Espumantes' | split: ',' %}{% for category in categories %}{% capture destination %}{% render 'category-link', category: category %}{% endcapture %}<a href="{{ destination | strip }}">{{ labels[forloop.index0] }}</a>{% endfor %}<a href="{{ routes.root_url }}#caixas">Caixas</a><a href="{{ routes.root_url }}#paises">Países</a><a href="{{ routes.root_url }}#bodegas">Marcas</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Minha conta</a>{% endif %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</nav></header>
<dialog class="zip-wishlist" data-wishlist-dialog aria-label="Meus favoritos"><div><h2>Meus favoritos</h2><button type="button" data-dialog-close aria-label="Fechar">{% render 'icon', name: 'close' %}</button></div><div data-wishlist-items></div><p>Favoritos salvos neste navegador.</p></dialog>
{% schema %}{"name":"Videira · Cabeçalho","class":"zip-header-section","settings":[{"type":"link_list","id":"menu","label":"Menu adicional"},{"type":"text","id":"announcement","label":"Mensagem da marca","default":"Videira Vinhoteca"}]}{% endschema %}

<section class="nv-harmonizations nv-container"><div class="nv-section-heading"><h2>Harmonizações</h2></div><div class="nv-harmonization-grid">{% assign names = 'Carnes vermelhas,Pizzas,Queijos,Orientais,Massas,Peixes,Carnes brancas' | split: ',' %}{% assign images = 'carnes,pizza,queijos,orientais,massas,peixes,carnes-brancas' | split: ',' %}{% assign categories = 'tinto,tinto,rose,branco,tinto,branco,branco' | split: ',' %}{% for name in names %}{% capture link %}{% render 'category-link', category: categories[forloop.index0] %}{% endcapture %}<a href="{{ link | strip }}">{% assign file = 'harmonizacao-' | append: images[forloop.index0] | append: '.jpg' %}<img src="{{ file | asset_url }}" alt="{{ name | escape }}" width="500" height="500" loading="lazy"><strong>{{ name }}</strong></a>{% endfor %}</div></section>
{% schema %}{"name":"Videira · Harmonizações","settings":[],"presets":[{"name":"Videira · Harmonizações"}]}{% endschema %}

<section class="nv-newsletter"><div class="nv-container"><div><h2>Fique por dentro da Videira</h2><p>Cadastre seu e-mail para receber novidades e seleções de vinhos.</p></div>{% form 'customer', class: 'nv-newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label for="NewsletterEmail-{{ section.id }}" class="nv-sr-only">Seu e-mail</label><input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="Digite seu e-mail" required autocomplete="email"><button type="submit">Cadastrar {% render 'icon', name: 'arrow' %}</button>{% if form.posted_successfully? %}<p role="status">Cadastro recebido. Obrigado!</p>{% endif %}{{ form.errors | default_errors }}{% endform %}</div></section>
{% schema %}{"name":"Videira · Newsletter","settings":[],"presets":[{"name":"Videira · Newsletter"}]}{% endschema %}

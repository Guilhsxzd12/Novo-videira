<section class="nv-categories nv-container" aria-labelledby="nv-categories-{{ section.id }}"><div class="nv-section-heading"><h2 id="nv-categories-{{ section.id }}">Compre por categoria</h2><a href="{{ routes.all_products_collection_url }}">Ver todos {% render 'icon', name: 'arrow' %}</a></div><div class="nv-category-grid">
{% for block in section.blocks %}
  {% capture fallback_url %}{% render 'category-link', category: block.settings.category %}{% endcapture %}
  {% assign category_image = block.settings.image %}
  {% if category_image == blank %}{% for product in collections.all.products %}{% capture matched %}{% render 'category-match', product: product, category: block.settings.category %}{% endcapture %}{% assign matched = matched | strip %}{% if matched == 'true' and product.featured_image %}{% assign category_image = product.featured_image %}{% break %}{% endif %}{% endfor %}{% endif %}
  <a class="nv-category nv-category--{{ block.settings.category }}" href="{{ block.settings.collection.url | default: fallback_url | strip }}" {{ block.shopify_attributes }}><span class="nv-category-photo">{% if category_image %}{{ category_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '160,300,500', sizes: '(max-width: 760px) 26vw, 180px', alt: block.settings.title }}{% else %}{% render 'icon', name: 'glass' %}{% endif %}</span><strong>{{ block.settings.title | escape }}</strong><span class="nv-category-cta">Ver vinhos {% render 'icon', name: 'arrow' %}</span></a>
{% endfor %}
</div></section>
{% schema %}
{"name":"Videira · Categorias","max_blocks":8,"settings":[],"blocks":[{"type":"category","name":"Categoria","settings":[{"type":"text","id":"title","label":"Título","default":"Tintos"},{"type":"select","id":"category","label":"Estilo","options":[{"value":"tinto","label":"Tintos"},{"value":"branco","label":"Brancos"},{"value":"rose","label":"Rosés"},{"value":"espumante","label":"Espumantes"}],"default":"tinto"},{"type":"collection","id":"collection","label":"Coleção de destino (opcional)"},{"type":"image_picker","id":"image","label":"Imagem (opcional)"}]}],"presets":[{"name":"Videira · Categorias","blocks":[{"type":"category","settings":{"title":"Tintos","category":"tinto"}},{"type":"category","settings":{"title":"Brancos","category":"branco"}},{"type":"category","settings":{"title":"Rosés","category":"rose"}},{"type":"category","settings":{"title":"Espumantes","category":"espumante"}}]}]}
{% endschema %}

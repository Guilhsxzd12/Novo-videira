<footer class="nv-footer nv-footer-traditional"><div class="nv-footer-grid nv-container">
<section class="zip-footer-group zip-footer-contact"><h2 class="nv-sr-only">Videira Vinhoteca</h2><div class="nv-footer-brand">{% render 'logo' %}<p>Venda proibida para menores de 18 anos. Aprecie com moderação. Se beber, não dirija.</p><small>Foz do Iguaçu · Paraná</small>{% if settings.whatsapp != blank %}<a href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' | escape }}" target="_blank" rel="noopener">Atendimento pelo WhatsApp</a>{% endif %}<div class="nv-footer-social"><a href="https://www.instagram.com/videiravinhoteca/" target="_blank" rel="noopener" aria-label="Instagram da Videira">{% render 'social-icon', name: 'instagram' %}</a>{% if settings.whatsapp != blank %}<a href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' | escape }}" target="_blank" rel="noopener" aria-label="WhatsApp da Videira">{% render 'social-icon', name: 'whatsapp' %}</a>{% endif %}</div></div></section>
<section class="zip-footer-group"><h2>Institucional</h2><div><a href="{{ routes.root_url }}">A Videira</a>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}{% for link in section.settings.footer_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</div></section>
<section class="zip-footer-group"><h2>Apoio ao Cliente</h2><div><a href="{{ routes.all_products_collection_url }}">Como comprar</a><a href="{{ routes.cart_url }}">Minha seleção</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Meus pedidos</a>{% endif %}{% if settings.whatsapp != blank %}<a href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' | escape }}" target="_blank" rel="noopener">Atendimento</a>{% endif %}<a href="{{ routes.root_url }}#caixas">Compra em caixas</a><a href="{{ routes.root_url }}#novidades">Novidades</a></div></section>
<section class="zip-footer-group"><h2>Compra segura</h2><div class="zip-footer-security"><p>{% render 'icon', name: 'bag' %}<span>Checkout integrado à Shopify</span></p><p>{% render 'icon', name: 'chat' %}<span>Atendimento da Videira</span></p></div></section>
<section class="zip-footer-group"><h2>Formas de pagamento</h2><div>{% if shop.enabled_payment_types.size > 0 %}<div class="zip-payment-icons">{% for payment_type in shop.enabled_payment_types %}{{ payment_type | payment_type_svg_tag }}{% endfor %}</div>{% else %}<p>Consulte as opções disponíveis ao finalizar sua compra.</p>{% endif %}<p>Frete, prazos e condições apresentados no checkout.</p></div></section>
</div><div class="nv-footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }} · Foz do Iguaçu, Paraná</span><span>Beba com moderação.</span></div></footer>
{% schema %}{"name":"Rodapé Videira","settings":[{"type":"link_list","id":"footer_menu","label":"Menu institucional"}]}{% endschema %}

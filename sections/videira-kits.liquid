{% assign source = section.settings.collection | default: collections.kits %}{% if source.products_count > 0 %}{% render 'carousel', collection: source, title: 'Selecione seu kit de vinhos', limit: 12 %}{% else %}<section id="caixas" class="nv-kits nv-container"><div class="nv-section-heading"><h2>Vinhos em caixas</h2></div><a class="nv-kit-banner" href="{% if settings.whatsapp != blank %}https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' | escape }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"><div><span>VIDEIRA VINHOTECA</span><h3>Mais garrafas.<br>Mais bons momentos.</h3><p>Escolha seus vinhos e consulte as condições para caixas.</p><strong>Fale com a Videira {% render 'icon', name: 'arrow' %}</strong></div><div class="nv-kit-bottles" aria-hidden="true">{% for product in collections.all.products limit: 4 %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: '' }}{% endif %}{% endfor %}</div></a></section>{% endif %}
{% schema %}{"name":"Videira · Kits e caixas","settings":[{"type":"collection","id":"collection","label":"Coleção de kits"}],"presets":[{"name":"Videira · Kits e caixas"}]}{% endschema %}

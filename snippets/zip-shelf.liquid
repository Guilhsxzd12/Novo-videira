{% if products.size > 0 %}<section class="zip-shelf zip-container wc-section" {% if anchor != blank %}id="{{ anchor }}"{% endif %}>{% render 'zip-title', title: title %}<div class="zip-shelf-wrap"><button type="button" class="zip-shelf-prev" data-carousel-step="-1" aria-label="Vinhos anteriores">‹</button><div class="wc-viewport" tabindex="0" aria-label="{{ title | escape }}"><div class="wc-track"><div class="wc-group">{% for product in products limit: 12 %}{% if boxes %}{% render 'zip-box-card', product: product %}{% else %}{% render 'product-card', product: product %}{% endif %}{% endfor %}</div></div></div><button type="button" class="zip-shelf-next" data-carousel-step="1" aria-label="Próximos vinhos">›</button></div></section>{% endif %}

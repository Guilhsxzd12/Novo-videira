<article class="sf-wine-card zip-box-card"><a class="sf-wine-visual" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 720 | image_tag: class: 'wine-photo', loading: 'lazy', alt: product.title }}{% endif %}<span class="zip-box-badge">6 GARRAFAS</span></a><div class="sf-wine-info"><a href="{{ product.url }}"><h3>Caixa com 6 · {{ product.title | escape }}</h3></a><p>{{ product.vendor | escape }}</p><div class="sf-wine-price"><small>6 unidades de {{ product.price | money }}</small><strong>{{ product.price | times: 6 | money }}</strong></div>{% if product.available and product.has_only_default_variant %}{% form 'product', product, class: 'sf-quick-add', data-shopify-add: '' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="6"><button class="sf-add" type="submit">Adicionar 6 garrafas</button>{% endform %}{% else %}<a class="sf-add" href="{{ product.url }}">{% if product.available %}Escolher opções{% else %}Ver produto{% endif %}</a>{% endif %}</div></article>
